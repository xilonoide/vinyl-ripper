<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VinylRipper\VinylRipper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\vinyl.ico</ApplicationIcon>
    <AssemblyTitle>Vinyl Ripper</AssemblyTitle>
    <Product>Vinyl Ripper</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\vinyl.ico" />
  </ItemGroup>

</Project>
