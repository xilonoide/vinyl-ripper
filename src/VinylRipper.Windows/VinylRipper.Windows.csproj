<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VinylRipper\VinylRipper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
    <Authors>xilonoide</Authors>
    <ApplicationIcon>Assets\vinyl.ico</ApplicationIcon>
    <AssemblyTitle>Vinyl Ripper</AssemblyTitle>
    <Product>Vinyl Ripper</Product>
  </PropertyGroup>

  <!-- Main propio (Program.cs): con un argumento arranca sólo el vigilante de temp, sin cargar WPF. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\vinyl.ico" />
    <!-- Pantalla de inicio: se muestra a mano desde App para controlar cuánto dura (no como SplashScreen). -->
    <Resource Include="Assets\splash.jpg" />
  </ItemGroup>

</Project>
