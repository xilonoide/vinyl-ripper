<Window x:Class="VinylRipper.Windows.Dialogs.DarkMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DarkWindow}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MinWidth="360" MaxWidth="680">
    <Grid Margin="20" MaxHeight="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="IconText" Grid.Column="0" FontSize="28" VerticalAlignment="Top" Margin="0,-4,16,0" />
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" TextTrimming="None" FontSize="13" LineHeight="20" />
        </ScrollViewer>
        <!-- Sólo con ShowWithAction: una acción (p. ej. "Reintentar"). Para no hacerla, se cierra con la X. -->
        <Button x:Name="ActionButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource AccentButton}"
                HorizontalAlignment="Right" Margin="0,16,0,0" MinWidth="120" Visibility="Collapsed"
                Click="ActionButton_Click" />
    </Grid>
</Window>
